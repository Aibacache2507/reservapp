# ==========================================
# RESERVAPP - Variables de Entorno (Ejemplo)
# ==========================================

# Supabase (URL y claves públicas/privadas)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# URL de la Aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (Envío de correos automáticos)
RESEND_API_KEY=re_1234567890abcdef
RESEND_FROM_EMAIL=notificaciones@reservapp.cl

# Configuración Regional por defecto
NEXT_PUBLIC_DEFAULT_TIMEZONE=America/Santiago
NEXT_PUBLIC_DEFAULT_CURRENCY=CLP
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=+56
